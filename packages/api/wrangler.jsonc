{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penfight-realtime",
  "main": "src/realtime-worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
